# Copy to .env and adjust for this machine. .env is gitignored; nothing here is a secret —
# credentials stay with each agent CLI (e.g. `pi auth`, `grok login`).
# Variables already set in the shell take precedence over this file.

# --- Vault workspace -------------------------------------------------------
# Git remote of the Obsidian vault repository the engine works on.
WORKSHEET_VAULT_REMOTE=git@github.com:your-name/your-vault.git
WORKSHEET_VAULT_BRANCH=main
# Identity used for the engine's commits in the vault.
WORKSHEET_BOT_NAME=worksheet-bot
WORKSHEET_BOT_EMAIL=worksheet-bot@users.noreply.github.com

# --- Paths (relative to the directory you run `worksheet` from) ------------
# Engine state: its own clone of the vault and run logs.
WORKSHEET_STATE_DIR=.state
# Runner / workspace / routing config, and role definitions.
WORKSHEET_CONFIG_DIR=config
WORKSHEET_ROLES_DIR=roles

# --- Agent CLIs and models -------------------------------------------------
# Used by config/runners.toml. Roles refer to runners by logical name
# (small / strong / web); these decide what each name runs on this machine.
WORKSHEET_PI_BIN=pi
WORKSHEET_GROK_BIN=grok
# small: the dispatcher (called often, no tools)
WORKSHEET_SMALL_MODEL=provider/small-model
# strong: librarian, tracker, writer (file tools, no network)
WORKSHEET_STRONG_MODEL=provider/strong-model
# web: researcher (web search, no shell)
WORKSHEET_WEB_MODEL=grok-4.7
