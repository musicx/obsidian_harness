# The .env for the Oracle host: copy to /opt/worksheet/.env and adjust. No secrets here —
# model credentials stay with the pi CLI of the agent user (pi's own auth), git credentials with the ubuntu user.

# Time zone for every date written into the vault (task ids, logs, capture dates); defaults to the host's zone.
WORKSHEET_TIMEZONE=Asia/Tokyo

# --- Vault workspace -------------------------------------------------------
WORKSHEET_VAULT_REMOTE=git@github.com:your-name/your-vault.git
WORKSHEET_VAULT_BRANCH=main
WORKSHEET_BOT_NAME=worksheet-bot
WORKSHEET_BOT_EMAIL=worksheet-bot@users.noreply.github.com

# This machine's entry in config/engines.toml.
WORKSHEET_ENGINE_ID=oracle

# --- Paths (relative to /opt/worksheet) ------------------------------------
WORKSHEET_STATE_DIR=.state
WORKSHEET_CONFIG_DIR=config
WORKSHEET_ROLES_DIR=roles
WORKSHEET_SKILLS_DIR=skills
WORKSHEET_VAULT_TEMPLATE_DIR=vault-template
WORKSHEET_RUNNERS_FILE=deploy/oracle/runners.toml
WORKSHEET_FEEDS_FILE=deploy/oracle/feeds.toml

# --- Agent sandbox ---------------------------------------------------------
# Every agent CLI runs as this unprivileged user through the wrapper (needs passwordless sudo for
# chown and `sudo -u wsagent` for the service user).
WORKSHEET_AGENT_WRAPPER=/opt/worksheet/deploy/oracle/run-as-agent.sh
WORKSHEET_AGENT_USER=wsagent

# --- Models (pi CLI) -------------------------------------------------------
WORKSHEET_PI_BIN=pi
WORKSHEET_SMALL_MODEL=anthropic/claude-haiku-5-5
WORKSHEET_STRONG_MODEL=anthropic/claude-sonnet-5-5
# Placeholder: must match a model id that `pi --list-models` shows on this host.
WORKSHEET_FALLBACK_MODEL=deepseek/deepseek-chat

# --- Briefing feeds --------------------------------------------------------
WORKSHEET_DIGEST_DATA_DIR=/srv/digest/www/data
WORKSHEET_SITE_URL=https://example.org
WORKSHEET_FEED_SINCE=2026-11-01
